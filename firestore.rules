rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Products collection rules
    match /products/{productId} {
      allow read: if true; // Anyone can read products
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }
    
    // Categories collection rules
    match /categories/{categoryId} {
      allow read: if true; // Anyone can read categories
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }
    
    // Foam collection rules
    match /foam/{foamId} {
      allow read: if true; // Anyone can read foam types
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }
    
    // Dimension Rules collection rules
    match /dimensionRules/{ruleId} {
      allow read: if true; // Anyone can read dimension rules
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }
    
    // Foam Grades collection rules
    match /foamGrades/{gradeId} {
      allow read: if true; // Anyone can read foam grades
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }
    
    // Fibre Wrap collection rules
    match /fibreWrap/{wrapId} {
      allow read: if true; // Anyone can read fibre wraps
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }
    
    // Custom Shapes collection rules
    match /custom_shapes/{shapeId} {
      allow read: if true; // Anyone can read custom shapes
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }

    // Bench Cushions collection rules
    match /benchCushions/{styleId} {
      allow read: if true; // Anyone can read bench cushion styles
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }

    // Fabric Price Tiers collection rules (superseded by fabricPriceTags — kept, unreferenced, for rollback safety)
    match /fabricPriceTiers/{tierId} {
      allow read: if true; // Anyone can read fabric price tiers
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }

    // Fabric Price Tags collection rules (replaces fabricPriceTiers — per-item $/yard rates)
    match /fabricPriceTags/{tagId} {
      allow read: if true; // Anyone can read fabric price tags
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }

    // Fabric Price Ranges collection rules — derived display labels, admin-managed
    match /fabricPriceRanges/{rangeId} {
      allow read: if true; // Anyone can read fabric price ranges
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }

    // Fabric Groups collection rules — admin-curated groupings, not yet customer-facing
    match /fabricGroups/{groupId} {
      allow read: if true; // Anyone can read fabric groups
      allow create, update, delete: if isAuthenticated(); // Only authenticated users can modify
    }

    // Charlotte Fabrics catalog collection rules (synced monthly from charlottefabrics.com)
    match /charlotteFabrics/{fabricId} {
      allow read: if true; // Anyone can read the fabric catalog
      allow create, update, delete: if isAuthenticated(); // Only authenticated users/admin scripts can modify
    }

    // Charlotte Fabrics sync run history — operational data, admin-only
    match /charlotteFabricsSyncRuns/{runId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only written by the admin-SDK sync script, which bypasses rules
    }

    // Free fabric sample requests. Public submission is untrusted, so creation only happens via
    // the admin-SDK-backed /api/fabric-samples/request route (bypasses rules), never the client
    // SDK. Authenticated admins can read the list and update status (e.g. mark shipped) directly.
    match /sampleRequests/{requestId} {
      allow read, update: if isAuthenticated();
      allow create, delete: if false;
    }
  }
}
