# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Phase 1 migration target: config/lookup data + admin auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Never expose to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Firebase (still in use for charlotteFabrics / sampleRequests until Phase 2) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
# Server-only. JSON string of the Firebase service account credentials.
FIREBASE_SERVICE_ACCOUNT=

# --- Cloudflare R2 (fabric catalog snapshot storage) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_S3_API_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# --- AI shopping guide (lib/ai/provider.ts) ---
# Primary provider — free tier, get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional; defaults to llama-3.3-70b-versatile if unset
GROQ_MODEL=
# Fallback provider if Groq is unset/unavailable

# --- Misc integrations ---
GITHUB_TOKEN=
GEMINI_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
